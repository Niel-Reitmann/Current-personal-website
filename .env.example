# Copy to .env.local for local work (and for scripts/send-post.mjs).
# In production, set these in Vercel -> Project -> Settings -> Environment Variables
# for Production and Preview. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend: use a SENDING-ONLY key restricted to your domain, not a full-access key.
RESEND_API_KEY=
EMAIL_FROM=Niel Reitmann <niel@nielreitmann.com>
# Where replies go. Kept in env so a personal address isn't in the public repo.
EMAIL_REPLY_TO=
